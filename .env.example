# Supabase browser credentials
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only Supabase service role key (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# WhatsApp Business Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=YOUR_PERMANENT_OR_TEMPORARY_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
WHATSAPP_ADMIN_PHONE=8801XXXXXXXXX
WHATSAPP_API_VERSION=v22.0

# Merchant payment receiving numbers shown at checkout (manual transfer + TrxID)
NEXT_PUBLIC_BKASH_NUMBER=01XXXXXXXXX
NEXT_PUBLIC_NAGAD_NUMBER=01XXXXXXXXX
